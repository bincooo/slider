// 用 Sobel 边缘检测 + 拼图轮廓对齐匹配算法
package main

import (
	"fmt"
	"image"
	"image/color"
	"image/draw"
	"image/png"
	"math"
	"os"
	"runtime"
	"sync"
)

// loadImage 从指定路径加载图片
func loadImage(path string) (image.Image, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer f.Close()
	img, _, err := image.Decode(f)
	return img, err
}

// saveImage 将图片以 PNG 格式保存到指定路径
func saveImage(img image.Image, path string) error {
	f, err := os.Create(path)
	if err != nil {
		return err
	}
	defer f.Close()
	return png.Encode(f, img)
}

// grayMatrix 将图片转换为灰度矩阵（0-1 浮点），用于 Sobel 边缘检测
func grayMatrix(img image.Image) [][]float64 {
	bounds := img.Bounds()
	width, height := bounds.Dx(), bounds.Dy()
	gray := make([][]float64, height)
	for y := range height {
		gray[y] = make([]float64, width)
		for x := range width {
			r, g, b, _ := img.At(bounds.Min.X+x, bounds.Min.Y+y).RGBA()
			rf := float64(uint8(r >> 8))
			gf := float64(uint8(g >> 8))
			bf := float64(uint8(b >> 8))
			gray[y][x] = (0.299*rf + 0.587*gf + 0.114*bf) / 255
		}
	}
	return gray
}

// sobelEdgeMagnitude 对灰度矩阵做 Sobel 算子卷积，计算每个像素的梯度幅值（边缘强度），
// 并归一化到 [0,1]。拼图缺口的描边线条会在这里表现为明显的高梯度区域，
// 这正是用来定位缺口轮廓的核心特征。
func sobelEdgeMagnitude(gray [][]float64) [][]float64 {
	height := len(gray)
	if height == 0 {
		return gray
	}
	width := len(gray[0])

	gx := [3][3]float64{{-1, 0, 1}, {-2, 0, 2}, {-1, 0, 1}}
	gy := [3][3]float64{{-1, -2, -1}, {0, 0, 0}, {1, 2, 1}}

	mag := make([][]float64, height)
	for y := range height {
		mag[y] = make([]float64, width)
	}

	maxMag := 0.0
	for y := 1; y < height-1; y++ {
		for x := 1; x < width-1; x++ {
			var sx, sy float64
			for ky := -1; ky <= 1; ky++ {
				for kx := -1; kx <= 1; kx++ {
					v := gray[y+ky][x+kx]
					sx += v * gx[ky+1][kx+1]
					sy += v * gy[ky+1][kx+1]
				}
			}
			m := math.Sqrt(sx*sx + sy*sy)
			mag[y][x] = m
			if m > maxMag {
				maxMag = m
			}
		}
	}

	if maxMag > 0 {
		for y := range height {
			for x := range width {
				mag[y][x] /= maxMag
			}
		}
	}
	return mag
}

// findOpaqueBoundingBox 在拼图碎片图中查找不透明区域的最小外接矩形
func findOpaqueBoundingBox(img image.Image, alphaThreshold uint32) image.Rectangle {
	bounds := img.Bounds()
	minX, minY := bounds.Max.X, bounds.Max.Y
	maxX, maxY := bounds.Min.X, bounds.Min.Y
	found := false
	for y := bounds.Min.Y; y < bounds.Max.Y; y++ {
		for x := bounds.Min.X; x < bounds.Max.X; x++ {
			_, _, _, a := img.At(x, y).RGBA()
			if a > alphaThreshold {
				found = true
				if x < minX {
					minX = x
				}
				if x > maxX {
					maxX = x
				}
				if y < minY {
					minY = y
				}
				if y > maxY {
					maxY = y
				}
			}
		}
	}
	if !found {
		return image.Rectangle{}
	}
	return image.Rect(minX, minY, maxX+1, maxY+1)
}

// cropImage 按给定矩形裁剪图片
func cropImage(img image.Image, rect image.Rectangle) image.Image {
	dst := image.NewRGBA(image.Rect(0, 0, rect.Dx(), rect.Dy()))
	draw.Draw(dst, dst.Bounds(), img, rect.Min, draw.Src)
	return dst
}

// extractShapeMask 从裁剪后的拼图碎片图中提取形状 mask
func extractShapeMask(img image.Image, alphaThreshold uint32) [][]bool {
	bounds := img.Bounds()
	width, height := bounds.Dx(), bounds.Dy()
	mask := make([][]bool, height)
	for y := range height {
		mask[y] = make([]bool, width)
		for x := range width {
			_, _, _, a := img.At(bounds.Min.X+x, bounds.Min.Y+y).RGBA()
			mask[y][x] = a > alphaThreshold
		}
	}
	return mask
}

// dilateMask 对 mask 进行方形结构元膨胀（可分离实现，O(H·W)）
func dilateMask(mask [][]bool, radius int) [][]bool {
	height := len(mask)
	if height == 0 {
		return mask
	}
	width := len(mask[0])

	horiz := make([][]bool, height)
	for y := range height {
		horiz[y] = make([]bool, width)
		prefix := make([]int, width+1)
		for x := range width {
			c := 0
			if mask[y][x] {
				c = 1
			}
			prefix[x+1] = prefix[x] + c
		}
		for x := range width {
			lo := max(x-radius, 0)
			hi := x + radius
			if hi >= width {
				hi = width - 1
			}
			horiz[y][x] = prefix[hi+1]-prefix[lo] > 0
		}
	}

	result := make([][]bool, height)
	for y := range result {
		result[y] = make([]bool, width)
	}
	for x := range width {
		prefix := make([]int, height+1)
		for y := range height {
			c := 0
			if horiz[y][x] {
				c = 1
			}
			prefix[y+1] = prefix[y] + c
		}
		for y := range height {
			lo := max(y-radius, 0)
			hi := y + radius
			if hi >= height {
				hi = height - 1
			}
			result[y][x] = prefix[hi+1]-prefix[lo] > 0
		}
	}

	return result
}

// invertMask 返回 mask 的取反结果
func invertMask(mask [][]bool) [][]bool {
	result := make([][]bool, len(mask))
	for y := range mask {
		result[y] = make([]bool, len(mask[y]))
		for x := range mask[y] {
			result[y][x] = !mask[y][x]
		}
	}
	return result
}

// erodeMask 对 mask 做方形结构元腐蚀。
// 利用形态学对偶关系实现：erode(mask, r) = NOT( dilate( NOT mask, r) )，
// 这样可以直接复用已经优化好的 dilateMask。
func erodeMask(mask [][]bool, radius int) [][]bool {
	return invertMask(dilateMask(invertMask(mask), radius))
}

// buildContourZoneMask 构建拼图形状"轮廓描边"所在的区域 mask：
// 取 dilate(shape, radius) 与 erode(shape, radius) 的差集，
// 也就是形状边界内外各 radius 像素范围内的一圈"轮廓带"，
// 对应缺口图片中那一圈可见的白色/浅色描边线条的大致宽度和位置。
func buildContourZoneMask(shapeMask [][]bool, radius int) [][]bool {
	dilated := dilateMask(shapeMask, radius)
	eroded := erodeMask(shapeMask, radius)
	height := len(shapeMask)
	width := len(shapeMask[0])
	result := make([][]bool, height)
	for y := range result {
		result[y] = make([]bool, width)
		for x := range result[y] {
			result[y][x] = dilated[y][x] && !eroded[y][x]
		}
	}
	return result
}

// offset 坐标偏移
type offset struct {
	dx, dy int
}

// maskToOffsets 将布尔 mask 转换为取值为 true 的坐标偏移列表
func maskToOffsets(mask [][]bool) []offset {
	var offsets []offset
	for ty := range mask {
		for tx := range mask[ty] {
			if mask[ty][tx] {
				offsets = append(offsets, offset{dx: tx, dy: ty})
			}
		}
	}
	return offsets
}

// MatchResult 匹配结果
type MatchResult struct {
	X, Y  int
	Score float64
}

// matchByEdgeAlignment 在背景图边缘强度图上滑动窗口，寻找与拼图轮廓描边最吻合的位置。
// 原理：如果窗口恰好落在真实缺口位置，轮廓带会与描边线条高度重合，平均边缘强度会明显更高。
func matchByEdgeAlignment(edgeMag [][]float64, contourMask [][]bool, baseY, yTolerance, skipLeft int) MatchResult {
	bgHeight := len(edgeMag)
	bgWidth := len(edgeMag[0])
	tplHeight := len(contourMask)
	tplWidth := len(contourMask[0])

	best := MatchResult{X: -1, Y: -1, Score: -math.MaxFloat64}

	yStart := baseY - yTolerance
	yEnd := baseY + yTolerance
	if yStart < 0 {
		yStart = 0
	}
	if yEnd > bgHeight-tplHeight {
		yEnd = bgHeight - tplHeight
	}
	if yStart > yEnd || skipLeft > bgWidth-tplWidth {
		return best
	}

	contourOffsets := maskToOffsets(contourMask)
	count := float64(len(contourOffsets))
	if count == 0 {
		return best
	}

	rowsTotal := yEnd - yStart + 1
	numWorkers := min(runtime.NumCPU(), rowsTotal)
	chunkSize := (rowsTotal + numWorkers - 1) / numWorkers

	var mu sync.Mutex
	var wg sync.WaitGroup

	searchRows := func(yFrom, yTo int) {
		defer wg.Done()
		localBest := MatchResult{X: -1, Y: -1, Score: -math.MaxFloat64}

		for y := yFrom; y <= yTo; y++ {
			for x := skipLeft; x <= bgWidth-tplWidth; x++ {
				var sum float64
				for _, o := range contourOffsets {
					sum += edgeMag[y+o.dy][x+o.dx]
				}
				score := sum / count

				if score > localBest.Score {
					localBest.Score = score
					localBest.X = x
					localBest.Y = y
				}
			}
		}

		mu.Lock()
		if localBest.Score > best.Score {
			best = localBest
		}
		mu.Unlock()
	}

	for i := 0; i < numWorkers; i++ {
		from := yStart + i*chunkSize
		if from > yEnd {
			break
		}
		to := from + chunkSize - 1
		if to > yEnd {
			to = yEnd
		}
		wg.Add(1)
		go searchRows(from, to)
	}
	wg.Wait()

	return best
}

// drawRect 在图片副本上沿矩形边框绘制指定颜色的线条，用于标记匹配结果，不修改原图
func drawRect(img image.Image, rect image.Rectangle, lineColor color.Color) *image.RGBA {
	bounds := img.Bounds()
	dst := image.NewRGBA(bounds)
	draw.Draw(dst, bounds, img, bounds.Min, draw.Src)
	for x := rect.Min.X; x < rect.Max.X; x++ {
		if x >= bounds.Min.X && x < bounds.Max.X {
			dst.Set(x, rect.Min.Y, lineColor)
			dst.Set(x, rect.Max.Y-1, lineColor)
		}
	}
	for y := rect.Min.Y; y < rect.Max.Y; y++ {
		if y >= bounds.Min.Y && y < bounds.Max.Y {
			dst.Set(rect.Min.X, y, lineColor)
			dst.Set(rect.Max.X-1, y, lineColor)
		}
	}
	return dst
}

func main() {
	// 1. 加载背景图（带缺口的完整图）和拼图碎片图（带透明通道）
	bgImg, err := loadImage("bg5.png")
	if err != nil {
		panic(err)
	}
	blockImg, err := loadImage("block5.png")
	if err != nil {
		panic(err)
	}

	fmt.Println("bg尺寸:", bgImg.Bounds())
	fmt.Println("block尺寸:", blockImg.Bounds())

	// 2. 在拼图碎片图中定位不透明区域，得到拼图形状的最小外接矩形
	alphaThreshold := uint32(30000)
	bbox := findOpaqueBoundingBox(blockImg, alphaThreshold)
	fmt.Println("拼图形状边界框:", bbox)
	if bbox.Empty() {
		panic("未找到拼图形状")
	}

	// 3. 裁剪出拼图形状区域，并提取形状 mask
	croppedBlock := cropImage(blockImg, bbox)
	shapeMask := extractShapeMask(croppedBlock, alphaThreshold)

	// 4. 构建轮廓描边区域 mask（形状边界内外各扩展 radius 像素），
	//    对应背景图缺口那圈可见描边线条的大致位置
	contourRadius := 2
	contourMask := buildContourZoneMask(shapeMask, contourRadius)

	// 5. 计算背景图的灰度矩阵 + Sobel 边缘强度图
	gray := grayMatrix(bgImg)
	edgeMag := sobelEdgeMagnitude(gray)

	// 拼图碎片在背景图中原本所处的行，与缺口所在行基本一致，作为搜索基准
	baseY := bbox.Min.Y
	// 跳过拼图碎片自身所在的左侧区域，避免把它自己误判为缺口
	skipLeft := bbox.Dx() + 5

	fmt.Println("推测缺口Y坐标:", baseY)

	// 6. 用边缘对齐的方式在背景图上滑动窗口搜索缺口位置
	result := matchByEdgeAlignment(edgeMag, contourMask, baseY, 8, skipLeft)
	fmt.Printf("匹配结果 -> X: %d, Y: %d, 得分: %.4f\n", result.X, result.Y, result.Score)

	if result.X < 0 {
		fmt.Println("未找到有效匹配")
		return
	}

	// 7. 在背景图上用矩形框标记出匹配到的缺口位置，方便可视化检查
	matchRect := image.Rect(result.X, result.Y, result.X+bbox.Dx(), result.Y+bbox.Dy())
	marked := drawRect(bgImg, matchRect, color.RGBA{G: 0xff, A: 0xff})
	if err = saveImage(marked, "marked.png"); err != nil {
		fmt.Println("保存标记图失败:", err)
	}

	fmt.Println()
	fmt.Println("======================")
	fmt.Printf("缺口X坐标: %d\n", result.X)
	fmt.Println("======================")
}
